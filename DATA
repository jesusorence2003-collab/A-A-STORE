                name: "Cafetera Prensa Francesa Acero",
                category: "Hogar",
                price: 24.00,
                oldPrice: 30.00,
                badge: null,
                description: "Doble pared aislante en acero inoxidable de 1 litro. Mantiene el calor.",
                image: "https://images.unsplash.com/photo-1517668808822-9ebb02f2a0e6?auto=format&fit=crop&w=600&q=80"
            },
            {
                id: 6,
                name: "Lámpara de Escritorio LED Minimal",
                category: "Hogar",
                price: 19.50,
                oldPrice: null,
                badge: null,
                description: "3 temperaturas de luz regulables y brazo flexible con control táctil.",
                image: "https://images.unsplash.com/photo-1507473885765-e6ed057f782c?auto=format&fit=crop&w=600&q=80"
            },
            {
                id: 7,
                name: "Gafas de Sol Polarizadas Classic",
                category: "Accesorios",
                price: 22.00,
                oldPrice: 28.00,
                badge: "Oferta",
                description: "Protección UV400 completa con montura ligera de acetato.",
                image: "https://images.unsplash.com/photo-1572635196237-14b3f281503f?auto=format&fit=crop&w=600&q=80"
            },
            {
                id: 8,
                name: "Chaqueta Cortavientos Ligera",
                category: "Moda",
                price: 42.00,
                oldPrice: null,
                badge: null,
                description: "Tela transpirable repelente al agua, ideal para clima variable.",
                image: "https://images.unsplash.com/photo-1591047139829-d91aecb6caea?auto=format&fit=crop&w=600&q=80"
            }
        ];

        /**
         * ============================================================================
         * ESTADO DE LA APLICACIÓN
         * ============================================================================
         */
        let cart = [];
        let selectedCategory = "Todos";
        let searchQuery = "";
        let sortBy = "featured";

        // Cargar carrito guardado en localStorage al iniciar
        try {
            const savedCart = localStorage.getItem('A&A STORE_cart');
            if (savedCart) cart = JSON.parse(savedCart);
        } catch (e) {
            console.error("Error cargando carrito:", e);
        }

        /**
         * ============================================================================
         * INICIALIZACIÓN Y EVENTOS
         * ============================================================================
         */
        document.addEventListener('DOMContentLoaded', () => {
            renderCategories();
            renderProducts();
            updateCartUI();

            // Eventos de búsqueda (Desktop y Móvil sincronizados)
            const searchDesktop = document.getElementById('searchInputDesktop');
            const searchMobile = document.getElementById('searchInputMobile');

            const handleSearch = (e) => {
                searchQuery = e.target.value.toLowerCase().trim();
                searchDesktop.value = e.target.value;
                searchMobile.value = e.target.value;
                renderProducts();
            };

            searchDesktop.addEventListener('input', handleSearch);
            searchMobile.addEventListener('input', handleSearch);

            // Evento de ordenamiento
            document.getElementById('sortSelect').addEventListener('change', (e) => {
                sortBy = e.target.value;
                renderProducts();
            });
        });

        /**
         * ============================================================================
         * RENDERIZADO DE CATEGORÍAS Y PRODUCTOS
         * ============================================================================
         */
        function renderCategories() {
            const categories = ["Todos", ...new Set(PRODUCTS.map(p => p.category))];
            const container = document.getElementById('categoryContainer');
            
            container.innerHTML = categories.map(cat => {
                const isActive = cat === selectedCategory;
                return `
                    <button 
                        onclick="selectCategory('${cat}')"
                        class="px-4 py-2 rounded-xl text-sm font-semibold whitespace-nowrap transition-all ${
                            isActive 
                            ? 'bg-slate-900 text-white shadow-sm' 
                            : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200/80'
                        }"
                    >
                        ${cat}
                    </button>
                `;
            }).join('');
        }

        function selectCategory(category) {
            selectedCategory = category;
            renderCategories();
            renderProducts();
        }

        function resetFilters() {
            selectedCategory = "Todos";
            searchQuery = "";
            sortBy = "featured";
            document.getElementById('searchInputDesktop').value = "";
            document.getElementById('searchInputMobile').value = "";
            document.getElementById('sortSelect').value = "featured";
            renderCategories();
            renderProducts();
        }

        function renderProducts() {
            const grid = document.getElementById('productsGrid');
            const emptyState = document.getElementById('emptyState');
            const countLabel = document.getElementById('productCount');

            // 1. Filtrar por categoría y búsqueda
            let filtered = PRODUCTS.filter(product => {
                const matchesCategory = selectedCategory === "Todos" || product.category === selectedCategory;
                const matchesSearch = product.name.toLowerCase().includes(searchQuery) || 
                                      product.description.toLowerCase().includes(searchQuery) ||
                                      product.category.toLowerCase().includes(searchQuery);
                return matchesCategory && matchesSearch;
            });

            // 2. Ordenar
            if (sortBy === 'price-asc') {
                filtered.sort((a, b) => a.price - b.price);
            } else if (sortBy === 'price-desc') {
                filtered.sort((a, b) => b.price - a.price);
            } else if (sortBy === 'name-asc') {
                filtered.sort((a, b) => a.name.localeCompare(b.name));
            }

            countLabel.textContent = `Mostrando ${filtered.length} ${filtered.length === 1 ? 'producto' : 'productos'}`;

            // 3. Mostrar estado vacío o tarjetas
            if (filtered.length === 0) {
                grid.innerHTML = "";
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');
            grid.innerHTML = filtered.map(product => `
                <article class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-xs hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col group">
                    <!-- Imagen del Producto -->
                    <div class="relative aspect-square bg-slate-100 overflow-hidden">
                        <img 
                            src="${product.image}" 
                            alt="${product.name}" 
                            onerror="this.src='https://placehold.co/600x600/e2e8f0/475569?text=Producto'"
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                            loading="lazy"
                        >
                        ${product.badge ? `
                            <span class="absolute top-3 left-3 bg-brand-600 text-white text-[11px] font-bold px-2.5 py-1 rounded-lg shadow-sm">
                                ${product.badge}
                            </span>
                        ` : ''}
                        <span class="absolute bottom-3 left-3 bg-white/90 backdrop-blur-xs text-slate-700 text-[11px] font-semibold px-2.5 py-1 rounded-lg">
                            ${product.category}
                        </span>
                    </div>

                    <!-- Detalles -->
                    <div class="p-5 flex-1 flex flex-col">
                        <h3 class="font-bold text-slate-900 text-base leading-snug mb-1.5 group-hover:text-brand-600 transition-colors">
                            ${product.name}
                        </h3>
                        <p class="text-slate-500 text-xs leading-relaxed mb-4 flex-1">
                            ${product.description}
                        </p>

                        <!-- Precio y Botón Agregar -->
                        <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
                            <div>
                                ${product.oldPrice ? `<span class="block text-xs text-slate-400 line-through">${formatMoney(product.oldPrice)}</span>` : ''}
                                <span class="text-lg font-extrabold text-slate-900">${formatMoney(product.price)}</span>
                            </div>

                            <button 
                                onclick="addToCart(${product.id})" 
                                class="bg-slate-900 hover:bg-brand-600 text-white font-semibold text-xs sm:text-sm px-4 py-2.5 rounded-xl transition-all flex items-center gap-1.5 active:scale-95 shadow-xs"
                            >
                                <i class="ph-bold ph-plus"></i> Agregar
                            </button>
                        </div>
                    </div>
                </article>
            `).join('');
        }

        /**
         * ============================================================================
         * GESTIÓN DEL CARRITO DE COMPRAS
         * ============================================================================
         */
        function addToCart(productId) {
            const product = PRODUCTS.find(p => p.id === productId);
            if (!product) return;

            const existingItem = cart.find(item => item.id === productId);
            if (existingItem) {
                existingItem.quantity += 1;
            } else {
                cart.push({ ...product, quantity: 1 });
            }

            saveCart();
            updateCartUI();
            showToast(`"${product.name}" agregado al carrito`);
        }

        function updateQuantity(productId, change) {
            const index = cart.findIndex(item => item.id === productId);
            if (index === -1) return;

            cart[index].quantity += change;
            if (cart[index].quantity <= 0) {
                cart.splice(index, 1);
            }

            saveCart();
            updateCartUI();
        }

        function removeFromCart(productId) {
            cart = cart.filter(item => item.id !== productId);
            saveCart();
            updateCartUI();
        }

        function saveCart() {
            try {
                localStorage.setItem('nexostore_cart', JSON.stringify(cart));
            } catch (e) {
                console.error("No se pudo guardar en localStorage:", e);
            }
        }

        function calculateTotals() {
            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            const shipping = subtotal === 0 ? 0 : (subtotal >= STORE_CONFIG.freeShippingThreshold ? 0 : STORE_CONFIG.standardShippingCost);
            const total = subtotal + shipping;

            return { subtotal, shipping, total, totalItems };
        }

        function updateCartUI() {
            const { subtotal, shipping, total, totalItems } = calculateTotals();
            
            // Actualizar badges de cantidad
            const badge = document.getElementById('cartBadge');
            badge.textContent = totalItems;
            badge.classList.add('scale-125');
            setTimeout(() => badge.classList.remove('scale-125'), 200);

            document.getElementById('drawerItemCount').textContent = `${totalItems} ${totalItems === 1 ? 'ítem' : 'ítems'}`;

            // Barra de envío gratis
            const freeShippingText = document.getElementById('freeShippingText');
            const freeShippingProgress = document.getElementById('freeShippingProgress');
            const remaining = STORE_CONFIG.freeShippingThreshold - subtotal;

            if (subtotal >= STORE_CONFIG.freeShippingThreshold) {
                freeShippingText.innerHTML = `<i class="ph-fill ph-check-circle text-emerald-600 text-base"></i> ¡Genial! Tienes <strong>Envío Gratis</strong> en este pedido.`;
                freeShippingProgress.style.width = '100%';
                freeShippingProgress.classList.replace('bg-brand-600', 'bg-emerald-500');
            } else {
                freeShippingText.innerHTML = `<i class="ph-fill ph-truck text-brand-600 text-base"></i> Agrega <strong>${formatMoney(remaining)}</strong> más para envío gratis.`;
                const pct = Math.min((subtotal / STORE_CONFIG.freeShippingThreshold) * 100, 100);
                freeShippingProgress.style.width = `${pct}%`;
                freeShippingProgress.classList.replace('bg-emerald-500', 'bg-brand-600');
            }

            // Renderizar lista de ítems
            const container = document.getElementById('cartItemsContainer');
            const footer = document.getElementById('cartFooter');

            if (cart.length === 0) {
                footer.classList.add('hidden');
                container.innerHTML = `
                    <div class="h-full flex flex-col items-center justify-center text-center py-12">
                        <div class="w-16 h-16 bg-slate-100 text-slate-400 rounded-2xl flex items-center justify-center mb-4">
                            <i class="ph ph-shopping-cart text-3xl"></i>
                        </div>
                        <h3 class="font-bold text-slate-900 mb-1">Tu carrito está vacío</h3>
                        <p class="text-xs text-slate-500 max-w-xs mb-6">Explora nuestro catálogo y agrega los productos que te gusten.</p>
                        <button onclick="toggleCart(false)" class="bg-slate-900 text-white text-xs font-semibold px-5 py-2.5 rounded-xl hover:bg-brand-600 transition-colors">
                            Explorar productos
                        </button>
                    </div>
                `;
                return;
            }

            footer.classList.remove('hidden');
            container.innerHTML = cart.map(item => `
                <div class="flex gap-3.5 bg-white p-3 rounded-2xl border border-slate-100 shadow-xs">
                    <img src="${item.image}" alt="${item.name}" onerror="this.src='https://placehold.co/150x150/e2e8f0/475569?text=Img'" class="w-20 h-20 rounded-xl object-cover bg-slate-100 shrink-0">
                    <div class="flex-1 min-w-0 flex flex-col justify-between">
                        <div class="flex justify-between items-start gap-2">
                            <h4 class="font-semibold text-slate-900 text-sm truncate">${item.name}</h4>
                            <button onclick="removeFromCart(${item.id})" class="text-slate-400 hover:text-rose-500 transition-colors p-0.5" title="Eliminar">
                                <i class="ph ph-trash text-base"></i>
                            </button>
                        </div>
                        <p class="text-xs text-slate-500">${formatMoney(item.price)} c/u</p>
                        
                        <div class="flex items-center justify-between mt-2">
                            <div class="inline-flex items-center bg-slate-100 rounded-lg p-0.5">
                                <button onclick="updateQuantity(${item.id}, -1)" class="w-7 h-7 flex items-center justify-center text-slate-600 hover:bg-white rounded-md font-bold transition-colors">-</button>
                                <span class="px-2.5 text-xs font-bold text-slate-900">${item.quantity}</span>
                                <button onclick="updateQuantity(${item.id}, 1)" class="w-7 h-7 flex items-center justify-center text-slate-600 hover:bg-white rounded-md font-bold transition-colors">+</button>
                            </div>
                            <span class="font-bold text-sm text-slate-900">${formatMoney(item.price * item.quantity)}</span>
                        </div>
                    </div>
                </div>
            `).join('');

            // Actualizar totales en footer
            document.getElementById('cartSubtotal').textContent = formatMoney(subtotal);
            document.getElementById('cartShipping').textContent = shipping === 0 ? 'GRATIS' : formatMoney(shipping);
            document.getElementById('cartTotal').textContent = formatMoney(total);
        }

        /**
         * ============================================================================
         * CONTROLES DE DRAWER Y MODALES
         * ============================================================================
         */
        function toggleCart(open) {
            const overlay = document.getElementById('cartOverlay');
            const drawer = document.getElementById('cartDrawer');

            if (open) {
                overlay.classList.remove('hidden');
                setTimeout(() => {
                    overlay.classList.remove('opacity-0');
                    drawer.classList.remove('translate-x-full');
                }, 10);
            } else {
                overlay.classList.add('opacity-0');
                drawer.classList.add('translate-x-full');
                setTimeout(() => {
                    overlay.classList.add('hidden');
                }, 300);
            }
        }

        function openCheckoutModal() {
            if (cart.length === 0) return;
            toggleCart(false);

            const { total, totalItems } = calculateTotals();
            document.getElementById('modalTotalAmount').textContent = formatMoney(total);
            document.getElementById('modalItemsCount').textContent = `${totalItems} ${totalItems === 1 ? 'producto' : 'productos'}`;

            const modal = document.getElementById('checkoutModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeCheckoutModal() {
            const modal = document.getElementById('checkoutModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function closeSuccessModal() {
            const modal = document.getElementById('successModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        /**
         * ============================================================================
         * FINALIZACIÓN DEL PEDIDO (WEB Y WHATSAPP)
         * ============================================================================
         */
        function handleOrderSubmit(e) {
            e.preventDefault();
            const customerName = document.getElementById('custName').value.trim();
            const orderNum = Math.floor(1000 + Math.random() * 9000);

            // Mostrar modal de éxito
            closeCheckoutModal();
            document.getElementById('successCustomerName').textContent = customerName;
            document.getElementById('successOrderNumber').textContent = `#${orderNum}`;

            const successModal = document.getElementById('successModal');
            successModal.classList.remove('hidden');
            successModal.classList.add('flex');

            // Vaciar carrito y formulario
            cart = [];
            saveCart();
            updateCartUI();
            document.getElementById('checkoutForm').reset();
        }

        function sendOrderViaWhatsApp() {
            const form = document.getElementById('checkoutForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const name = document.getElementById('custName').value.trim();
            const phone = document.getElementById('custPhone').value.trim();
            const address = document.getElementById('custAddress').value.trim();
            const payment = document.getElementById('custPayment').value;
            const notes = document.getElementById('custNotes').value.trim();

            const { subtotal, shipping, total } = calculateTotals();

            // Construir mensaje estructurado para WhatsApp
            let message = `🛍️ *NUEVO PEDIDO - ${STORE_CONFIG.storeName}*\n\n`;
            message += `👤 *Cliente:* ${name}\n`;
            message += `📱 *Teléfono:* ${phone}\n`;
            message += `📍 *Dirección:* ${address}\n`;
            message += `💳 *Método de pago:* ${payment}\n`;
            if (notes) message += `📝 *Notas:* ${notes}\n`;
            
            message += `\n📦 *DETALLE DEL PEDIDO:*\n`;
            cart.forEach(item => {
                message += `• ${item.quantity}x ${item.name} (${formatMoney(item.price * item.quantity)})\n`;
            });

            message += `\n💵 *Subtotal:* ${formatMoney(subtotal)}\n`;
            message += `🚚 *Envío:* ${shipping === 0 ? 'GRATIS' : formatMoney(shipping)}\n`;
            message += `✅ *TOTAL A PAGAR: ${formatMoney(total)}*`;

            const encodedMessage = encodeURIComponent(message);
            const whatsappUrl = `https://wa.me/${STORE_CONFIG.whatsappNumber}?text=${encodedMessage}`;

            // Abrir WhatsApp en nueva pestaña
            window.open(whatsappUrl, '_blank');
        }

        function openWhatsAppDirect() {
            const msg = encodeURIComponent(`¡Hola ${STORE_CONFIG.storeName}! Me gustaría hacer una consulta sobre sus productos.`);
            window.open(`https://wa.me/${STORE_CONFIG.whatsappNumber}?text=${msg}`, '_blank');
        }

        /**
         * ============================================================================
         * UTILIDADES
         * ============================================================================
         */
        function formatMoney(amount) {
            return `${STORE_CONFIG.currency}${amount.toFixed(2)}`;
        }

        let toastTimeout;
        function showToast(text) {
            const toast = document.getElementById('toastNotification');
            document.getElementById('toastMessage').textContent = text;
            
            toast.classList.remove('translate-y-20', 'opacity-0');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 2600);
        }
    </script>
</body>
</html>
