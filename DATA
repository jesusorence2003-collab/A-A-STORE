<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> A&A STORE | Tu Tienda favorita Online</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Phosphor Icons para iconos limpios y modernos -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#1e1b4b',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased selection:bg-brand-600 selection:text-white flex flex-col min-h-screen">

    <!-- ================= BARRA DE NAVEGACIÓN ================= -->
    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200/80 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16 sm:h-20">
                <!-- Logo / Nombre de la Tienda -->
                <a href="#" class="flex items-center gap-2.5 group">
                    <div class="w-10 h-10 rounded-xl bg-brand-600 text-white flex items-center justify-center shadow-md shadow-brand-600/20 group-hover:scale-105 transition-transform">
                        <i class="ph-bold ph-storefront text-2xl"></i>
                    </div>
                    <div>
                        <span class="font-extrabold text-xl tracking-tight text-slate-900">A&A<span class="text-brand-600">Store</span></span>
                        <span class="hidden sm:block text-[11px] font-medium text-slate-400 -mt-1">Catálogo Oficial</span>
                    </div>
                </a>

                <!-- Buscador Desktop -->
                <div class="hidden md:flex flex-1 max-w-md mx-8">
                    <div class="relative w-full">
                        <i class="ph ph-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg"></i>
                        <input 
                            type="text" 
                            id="searchInputDesktop" 
                            placeholder="Buscar productos, marcas..." 
                            class="w-full pl-10 pr-4 py-2.5 bg-slate-100 border border-transparent focus:bg-white focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 rounded-xl text-sm transition-all outline-none"
                        >
                    </div>
                </div>

                <!-- Botón Carrito -->
                <div class="flex items-center gap-3">
                    <button 
                        onclick="toggleCart(true)" 
                        class="relative inline-flex items-center gap-2.5 bg-slate-900 hover:bg-brand-600 text-white px-4 py-2.5 rounded-xl font-medium text-sm transition-all duration-200 shadow-sm hover:shadow-md active:scale-95"
                        aria-label="Abrir carrito de compras"
                    >
                        <i class="ph-bold ph-shopping-bag text-lg"></i>
                        <span class="hidden sm:inline">Mi Carrito</span>
                        <span id="cartBadge" class="bg-brand-500 text-white text-xs font-bold px-2 py-0.5 rounded-full min-w-[22px] text-center transition-transform">0</span>
                    </button>
                </div>
            </div>

            <!-- Buscador Móvil -->
            <div class="pb-3 md:hidden">
                <div class="relative w-full">
                    <i class="ph ph-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg"></i>
                    <input 
                        type="text" 
                        id="searchInputMobile" 
                        placeholder="Buscar en el catálogo..." 
                        class="w-full pl-10 pr-4 py-2 bg-slate-100 border border-transparent focus:bg-white focus:border-brand-500 rounded-xl text-sm outline-none"
                    >
                </div>
            </div>
        </div>
    </header>

    <!-- ================= BANNER PRINCIPAL (HERO) ================= -->
    <section class="bg-gradient-to-br from-slate-900 via-brand-900 to-slate-900 text-white relative overflow-hidden">
        <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:20px_20px]"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 relative z-10 flex flex-col md:flex-row items-center justify-between gap-8">
            <div class="max-w-2xl text-center md:text-left">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-brand-500/20 text-brand-100 border border-brand-400/30 mb-4">
                    <i class="ph-fill ph-sparkle text-amber-400"></i> Envíos rápidos y seguros
                </span>
                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight mb-4">
                    Descubre productos increíbles al mejor precio
                </h1>
                <p class="text-slate-300 text-base sm:text-lg mb-6 max-w-xl mx-auto md:mx-0">
                    Explora nuestro catálogo actualizado, arma tu pedido en segundos y recíbelo directamente en la puerta de tu casa.
                </p>
                <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
                    <a href="#catalogo" class="bg-brand-600 hover:bg-brand-500 text-white font-semibold px-6 py-3 rounded-xl transition-all shadow-lg shadow-brand-600/30 inline-flex items-center gap-2">
                        Ver Catálogo <i class="ph-bold ph-arrow-down"></i>
                    </a>
                    <button onclick="openWhatsAppDirect()" class="bg-white/10 hover:bg-white/20 backdrop-blur-sm text-white font-medium px-5 py-3 rounded-xl transition-all inline-flex items-center gap-2 border border-white/10">
                        <i class="ph-fill ph-whatsapp-logo text-emerald-400 text-xl"></i> Consultar por WhatsApp
                    </button>
                </div>
            </div>
            
            <!-- Tarjeta flotante informativa -->
            <div class="hidden lg:grid grid-cols-2 gap-4 w-full max-w-md">
                <div class="bg-white/10 backdrop-blur-md p-5 rounded-2xl border border-white/10">
                    <i class="ph-duotone ph-truck text-3xl text-brand-400 mb-2"></i>
                    <h3 class="font-bold text-white text-sm">Envío Gratis</h3>
                    <p class="text-xs text-slate-300 mt-1">En compras superiores a $50.00</p>
                </div>
                <div class="bg-white/10 backdrop-blur-md p-5 rounded-2xl border border-white/10">
                    <i class="ph-duotone ph-shield-check text-3xl text-emerald-400 mb-2"></i>
                    <h3 class="font-bold text-white text-sm">Compra Segura</h3>
                    <p class="text-xs text-slate-300 mt-1">Pago contra entrega o transferencia</p>
                </div>
                <div class="bg-white/10 backdrop-blur-md p-5 rounded-2xl border border-white/10 col-span-2 flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
                        <i class="ph-fill ph-whatsapp-logo text-2xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-white text-sm">Atención Personalizada</h3>
                        <p class="text-xs text-slate-300 mt-0.5">Envía tu carrito directo a nuestro WhatsApp con un clic.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= CONTENIDO PRINCIPAL: CATÁLOGO ================= -->
    <main id="catalogo" class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10">
        
        <!-- Barra de Filtros y Ordenamiento -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
            <!-- Botones de Categorías -->
            <div id="categoryContainer" class="flex items-center gap-2 overflow-x-auto pb-2 md:pb-0 no-scrollbar">
                <!-- Se generan dinámicamente con JS -->
            </div>

            <!-- Selector de Orden -->
            <div class="flex items-center justify-between sm:justify-end gap-3 shrink-0">
                <span id="productCount" class="text-sm text-slate-500 font-medium">Mostrando 0 productos</span>
                <select id="sortSelect" class="bg-white border border-slate-200 text-slate-700 text-sm rounded-xl px-3.5 py-2.5 focus:outline-none focus:border-brand-500 shadow-sm cursor-pointer">
                    <option value="featured">Destacados</option>
                    <option value="price-asc">Precio: Menor a Mayor</option>
                    <option value="price-desc">Precio: Mayor a Menor</option>
                    <option value="name-asc">Nombre: A - Z</option>
                </select>
            </div>
        </div>

        <!-- Cuadrícula de Productos -->
        <div id="productsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            <!-- Las tarjetas de productos se inyectan aquí mediante JavaScript -->
        </div>

        <!-- Estado Vacío (si la búsqueda no arroja resultados) -->
        <div id="emptyState" class="hidden text-center py-16 px-4 bg-white rounded-3xl border border-slate-200/80 shadow-sm">
            <div class="w-16 h-16 bg-slate-100 text-slate-400 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <i class="ph ph-magnifying-glass text-3xl"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-1">No encontramos productos</h3>
            <p class="text-slate-500 text-sm max-w-md mx-auto mb-6">Intenta buscar con otras palabras o selecciona otra categoría para ver todo nuestro inventario disponible.</p>
            <button onclick="resetFilters()" class="bg-brand-600 hover:bg-brand-700 text-white font-medium px-5 py-2.5 rounded-xl text-sm transition-colors">
                Ver todos los productos
            </button>
        </div>
    </main>

    <!-- ================= PIE DE PÁGINA ================= -->
    <footer class="bg-white border-t border-slate-200 mt-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-brand-600 text-white flex items-center justify-center">
                    <i class="ph-bold ph-storefront text-lg"></i>
                </div>
                <span class="font-bold text-slate-900">A&A STORE</span>
            </div>
            <p class="text-sm text-slate-500 text-center sm:text-left">
                © 2026 A&A STORE. Todos los derechos reservados. Precios expresados en USD (€).
            </p>
            <div class="flex items-center gap-4 text-slate-400">
                <a href="#" class="hover:text-brand-600 transition-colors" aria-label="Instagram"><i class="ph-fill ph-instagram-logo text-xl"></i></a>
                <a href="#" class="hover:text-brand-600 transition-colors" aria-label="Facebook"><i class="ph-fill ph-facebook-logo text-xl"></i></a>
                <button onclick="openWhatsAppDirect()" class="hover:text-emerald-600 transition-colors" aria-label="WhatsApp"><i class="ph-fill ph-whatsapp-logo text-xl"></i></button>
            </div>
        </div>
    </footer>

    <!-- ================= DRAWER LATERAL DEL CARRITO DE COMPRAS ================= -->
    <div id="cartOverlay" onclick="toggleCart(false)" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 hidden opacity-0 transition-opacity duration-300"></div>
    
    <aside id="cartDrawer" class="fixed top-0 right-0 h-full w-full max-w-md bg-white z-50 shadow-2xl transform translate-x-full transition-transform duration-300 ease-out flex flex-col">
        <!-- Cabecera del Carrito -->
        <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between bg-white">
            <div class="flex items-center gap-2.5">
                <i class="ph-bold ph-shopping-bag text-brand-600 text-xl"></i>
                <h2 class="font-bold text-lg text-slate-900">Tu Carrito</h2>
                <span id="drawerItemCount" class="text-xs font-semibold bg-slate-100 text-slate-600 px-2.5 py-0.5 rounded-full">0 ítems</span>
            </div>
            <button onclick="toggleCart(false)" class="p-2 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-xl transition-colors" aria-label="Cerrar carrito">
                <i class="ph-bold ph-x text-lg"></i>
            </button>
        </div>

        <!-- Barra de Progreso Envío Gratis -->
        <div id="freeShippingBar" class="bg-brand-50 px-6 py-3 border-b border-brand-100">
            <p id="freeShippingText" class="text-xs font-medium text-brand-900 mb-1.5 flex items-center gap-1.5">
                <i class="ph-fill ph-truck text-brand-600 text-base"></i> ¡Agrega $50.00 para obtener envío gratis!
            </p>
            <div class="w-full bg-brand-200/70 rounded-full h-1.5 overflow-hidden">
                <div id="freeShippingProgress" class="bg-brand-600 h-full rounded-full transition-all duration-300" style="width: 0%"></div>
            </div>
        </div>

        <!-- Lista de Productos en el Carrito -->
        <div id="cartItemsContainer" class="flex-1 overflow-y-auto p-6 space-y-4">
            <!-- Se llena dinámicamente -->
        </div>

        <!-- Resumen y Botón de Checkout -->
        <div id="cartFooter" class="p-6 bg-slate-50 border-t border-slate-200 hidden">
            <div class="space-y-2 text-sm mb-4">
                <div class="flex justify-between text-slate-500">
                    <span>Subtotal</span>
                    <span id="cartSubtotal" class="font-medium text-slate-800">$0.00</span>
                </div>
                <div class="flex justify-between text-slate-500">
                    <span>Costo de envío</span>
                    <span id="cartShipping" class="font-medium text-slate-800">$5.00</span>
                </div>
                <div class="flex justify-between text-base font-extrabold text-slate-900 pt-2 border-t border-slate-200">
                    <span>Total a pagar</span>
                    <span id="cartTotal" class="text-brand-600 text-lg">$0.00</span>
                </div>
            </div>

            <button onclick="openCheckoutModal()" class="w-full bg-brand-600 hover:bg-brand-700 text-white font-bold py-3.5 px-6 rounded-xl shadow-lg shadow-brand-600/25 transition-all flex items-center justify-center gap-2 active:scale-[0.99]">
                Finalizar Pedido <i class="ph-bold ph-arrow-right"></i>
            </button>
        </div>
    </aside>

    <!-- ================= MODAL DE FINALIZAR COMPRA (CHECKOUT) ================= -->
    <div id="checkoutModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs overflow-y-auto">
        <div class="bg-white rounded-3xl max-w-lg w-full shadow-2xl overflow-hidden my-auto border border-slate-100 animate-fade-in">
            <!-- Header Modal -->
            <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                <h3 class="font-bold text-lg text-slate-900 flex items-center gap-2">
                    <i class="ph-duotone ph-package text-brand-600 text-xl"></i> Datos de Envío y Pago
                </h3>
                <button onclick="closeCheckoutModal()" class="p-2 text-slate-400 hover:text-slate-700 rounded-xl hover:bg-slate-200/50 transition-colors">
                    <i class="ph-bold ph-x"></i>
                </button>
            </div>

            <!-- Formulario -->
            <form id="checkoutForm" onsubmit="handleOrderSubmit(event)" class="p-6 space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Nombre Completo *</label>
                        <input type="text" id="custName" required placeholder="Ej. María González" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-brand-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Teléfono / WhatsApp *</label>
                        <input type="tel" id="custPhone" required placeholder="Ej. +58 412 1234567" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-brand-500 outline-none">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Dirección de Entrega *</label>
                    <input type="text" id="custAddress" required placeholder="Calle, número de casa/edificio, ciudad y referencia" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-brand-500 outline-none">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Método de Pago *</label>
                        <select id="custPayment" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-brand-500 outline-none">
                            <option value="Efectivo contra entrega">Efectivo contra entrega</option>
                            <option value="Transferencia / Pago Móvil">Transferencia / Pago Móvil</option>
                            <option value="Zelle / Divisas">Zelle / Divisas</option>
                            <option value="Tarjeta de Crédito/Débito">Tarjeta al recibir</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Notas (Opcional)</label>
                        <input type="text" id="custNotes" placeholder="Ej. Tocar timbre azul" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:border-brand-500 outline-none">
                    </div>
                </div>

                <!-- Mini Resumen dentro del modal -->
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200/80 flex items-center justify-between">
                    <div>
                        <p class="text-xs text-slate-500">Total del pedido (incluye envío)</p>
                        <p id="modalTotalAmount" class="text-xl font-extrabold text-slate-900">$0.00</p>
                    </div>
                    <span id="modalItemsCount" class="text-xs font-semibold bg-brand-100 text-brand-700 px-3 py-1 rounded-full">0 productos</span>
                </div>

                <!-- Botones de Acción: Confirmar en Web o Enviar por WhatsApp -->
                <div class="pt-2 flex flex-col sm:flex-row gap-3">
                    <button type="submit" class="flex-1 bg-slate-900 hover:bg-slate-800 text-white font-semibold py-3 px-4 rounded-xl text-sm transition-all flex items-center justify-center gap-2 shadow-sm">
                        <i class="ph-bold ph-check-circle text-lg"></i> Confirmar Pedido
                    </button>
                    <button type="button" onclick="sendOrderViaWhatsApp()" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3 px-4 rounded-xl text-sm transition-all flex items-center justify-center gap-2 shadow-md shadow-emerald-600/20">
                        <i class="ph-fill ph-whatsapp-logo text-lg"></i> Pedir por WhatsApp
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ================= MODAL DE CONFIRMACIÓN EXITOSA ================= -->
    <div id="successModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs">
        <div class="bg-white rounded-3xl max-w-md w-full p-8 text-center shadow-2xl border border-slate-100">
            <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="ph-bold ph-check text-3xl"></i>
            </div>
            <h3 class="text-2xl font-extrabold text-slate-900 mb-2">¡Pedido Recibido!</h3>
            <p class="text-slate-500 text-sm mb-6">
                Gracias por tu compra, <span id="successCustomerName" class="font-semibold text-slate-800"></span>. Hemos registrado tu orden <span id="successOrderNumber" class="font-mono font-bold text-brand-600">#0000</span> y nos pondremos en contacto contigo pronto.
            </p>
            <button onclick="closeSuccessModal()" class="w-full bg-brand-600 hover:bg-brand-700 text-white font-semibold py-3 rounded-xl transition-colors">
                Seguir comprando
            </button>
        </div>
    </div>

    <!-- ================= NOTIFICACIÓN TOAST FLOTANTE ================= -->
    <div id="toastNotification" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
        <div class="bg-slate-900 text-white px-4 py-3 rounded-2xl shadow-xl flex items-center gap-3 text-sm font-medium border border-slate-700">
            <div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
                <i class="ph-bold ph-check"></i>
            </div>
            <span id="toastMessage">Producto agregado al carrito</span>
        </div>
    </div>

    <!-- ================= LÓGICA JAVASCRIPT ================= -->
